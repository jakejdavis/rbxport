<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). Cocoa Scripting reads these. -->
	<!-- Languages Localizable.xcstrings carries (macos/scripts/build-xcstrings.mjs); the picker in Settings > View chooses among them. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
		<string>de</string>
		<string>es</string>
		<string>it</string>
		<string>nl</string>
		<string>ru</string>
		<string>pt</string>
		<string>sv</string>
		<string>da</string>
		<string>tr</string>
		<string>el</string>
		<string>hu</string>
		<string>cs</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ko</string>
		<string>ja</string>
	</array>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>rbxport.sdef</string>
</dict>
</plist>
