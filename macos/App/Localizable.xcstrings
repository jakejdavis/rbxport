    "Make this computer the tempo master; players set to SYNC follow this tempo." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělejte z tohoto počítače mistra tempa; hráči nastavení na SYNC sledují toto tempo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør denne computer til tempomester; spillere indstillet til SYNC følger dette tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie diesen Computer zum Tempo-Master; Spieler, die auf SYNC eingestellt sind, folgen diesem Tempo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε αυτόν τον υπολογιστή τον κύριο ρυθμό. Οι παίκτες που έχουν οριστεί σε SYNC ακολουθούν αυτό το ρυθμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga de esta computadora el maestro del tempo; Los reproductores configurados en SYNC siguen este tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites de cet ordinateur le maître du tempo ; les joueurs réglés sur SYNC suivent ce tempo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd ezt a számítógépet tempómesterré; A SYNC-re beállított játékosok ezt a tempót követik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi questo computer il maestro del tempo; i giocatori impostati su SYNC seguono questo tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピュータをテンポマスターにします。 SYNC に設定されたプレーヤーはこのテンポに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컴퓨터를 템포 마스터로 만드십시오. SYNC로 설정된 플레이어는 이 템포를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak van deze computer de tempomaster; Spelers die zijn ingesteld op SYNC volgen dit tempo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça deste computador o mestre do tempo; jogadores configurados para SYNC seguem esse andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте этот компьютер мастером темпа; игроки, настроенные на SYNC, следуют этому темпу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör den här datorn till tempomästare; spelare inställda på SYNC följer detta tempo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bilgisayarı tempo yöneticisi yapın; SYNC'e ayarlanmış oyuncular bu tempoyu takip eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让这台电脑成为节奏大师；设置为 SYNC 的玩家遵循此节奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓這台電腦成為節奏大師；設定為 SYNC 的玩家遵循此節奏。"
          }
        }
      }
    },
