    "You can keep using RBXport while this runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během tohoto běhu můžete RBXport používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortsætte med at bruge RBXport, mens dette kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können RBXport während der Ausführung weiterhin verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να συνεχίσετε να χρησιμοποιείτε το RBXport όσο εκτελείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede seguir usando RBXport mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez continuer à utiliser RBXport pendant son exécution."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg ez fut, továbbra is használhatja az RBXportot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi continuare a utilizzare RBXport mentre è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが実行されている間、RBXport を使用し続けることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것이 실행되는 동안 RBXport를 계속 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt RBXport blijven gebruiken terwijl dit actief is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode continuar usando o RBXport enquanto ele é executado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете продолжать использовать RBXport, пока он работает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortsätta använda RBXport medan detta körs."
