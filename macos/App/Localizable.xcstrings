    },
    "1 device on the network. Turn PRO DJ LINK on to serve this library to it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 zařízení v síti. Zapněte PRO DJ LINK, chcete-li mu tuto knihovnu poskytovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 enhed på netværket. Slå PRO DJ LINK til for at betjene dette bibliotek til det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Gerät im Netzwerk. Schalten Sie PRO DJ LINK ein, um ihm diese Bibliothek bereitzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 συσκευή στο δίκτυο. Ενεργοποιήστε το PRO DJ LINK για να του εξυπηρετήσετε αυτήν τη βιβλιοθήκη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dispositivo en la red. Active PRO DJ LINK para enviarle esta biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 appareil sur le réseau. Activez PRO DJ LINK pour lui servir cette bibliothèque."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 eszköz a hálózaton. Kapcsolja be a PRO DJ LINK szolgáltatást, hogy kiszolgálja a könyvtárat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dispositivo in rete. Attiva PRO DJ LINK per fornirgli questa libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク上に 1 台のデバイス。このライブラリを PRO DJ LINK に提供するには、PRO DJ LINK をオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크에 장치 1개가 있습니다. PRO DJ LINK를 켜서 이 라이브러리를 제공하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 apparaat op het netwerk. Schakel PRO DJ LINK in om deze bibliotheek aan te bieden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dispositivo na rede. Ative o PRO DJ LINK para servir esta biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 устройство в сети. Включите PRO DJ LINK, чтобы передать ему эту библиотеку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 enhet i nätverket. Slå på PRO DJ LINK för att servera det här biblioteket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağda 1 cihaz. Bu kitaplığa hizmet vermek için PRO DJ LINK'i açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络上有 1 台设备。打开 PRO DJ LINK 以向其提供该库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網路上有 1 台設備。打開 PRO DJ LINK 以向其提供該庫。"
          }
        }
      }
    },
