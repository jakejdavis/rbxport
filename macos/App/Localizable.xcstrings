        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 USB 장치가 더 이상 연결되어 있지 않습니다. 새로고침하고 다시 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
