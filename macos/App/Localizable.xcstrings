    "Turn on PRO DJ LINK automatically when a player or mixer is detected." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte PRO DJ LINK automaticky, když je detekován přehrávač nebo mix."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænd for PRO DJ LINK automatisk, når en afspiller eller mixer registreres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie PRO DJ LINK automatisch ein, wenn ein Player oder Mixer erkannt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε αυτόματα το PRO DJ LINK όταν εντοπιστεί συσκευή αναπαραγωγής ή μίκτη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende PRO DJ LINK automáticamente cuando se detecta un reproductor o mezclador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez automatiquement PRO DJ LINK lorsqu'un lecteur ou une table de mixage est détecté."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be automatikusan a PRO DJ LINK funkciót, ha lejátszót vagy keverőt észlel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva automaticamente PRO DJ LINK quando viene rilevato un lettore o un mixer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーまたはミキサーを検出すると、PRO DJ LINK が自動的にオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어 또는 믹서가 감지되면 자동으로 PRO DJ LINK를 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel PRO DJ LINK automatisch in wanneer een speler of mixer wordt gedetecteerd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue o PRO DJ LINK automaticamente quando um player ou mixer for detectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включайте PRO DJ LINK автоматически при обнаружении проигрывателя или микшера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på PRO DJ LINK automatiskt när en spelare eller mixer upptäcks."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oynatıcı veya mikser algılandığında PRO DJ LINK'i otomatik olarak açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当检测到播放器或混音器时，自动打开 PRO DJ LINK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當偵測到播放器或混音器時，自動開啟 PRO DJ LINK。"
          }
        }
      }
    },
    "Turn on your players and mixers, then connect them to the network shown above." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte své přehrávače a mixpulty a poté je připojte k výše uvedené síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænd for dine afspillere og mixere, og tilslut dem derefter til netværket vist ovenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie Ihre Player und Mixer ein und verbinden Sie sie dann mit dem oben gezeigten Netzwerk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε τα προγράμματα αναπαραγωγής και τους μίκτες σας και, στη συνέχεια, συνδέστε τα στο δίκτυο που φαίνεται παραπάνω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encienda sus reproductores y mezcladores, luego conéctelos a la red que se muestra arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allumez vos lecteurs et mixeurs, puis connectez-les au réseau indiqué ci-dessus."
