    "The export failed before the device could be verified. Check that it is connected, writable, and has enough free space." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export se nezdařil, než bylo možné zařízení ověřit. Zkontrolujte, zda je připojený, zapisovatelný a má dostatek volného místa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporten mislykkedes, før enheden kunne bekræftes. Tjek, at den er tilsluttet, skrivbar og har nok ledig plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export ist fehlgeschlagen, bevor das Gerät überprüft werden konnte. Überprüfen Sie, ob es angeschlossen und beschreibbar ist und über genügend freien Speicherplatz verfügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εξαγωγή απέτυχε πριν μπορέσει να επαληθευτεί η συσκευή. Ελέγξτε ότι είναι συνδεδεμένο, εγγράψιμο και ότι έχει αρκετό ελεύθερο χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación falló antes de que se pudiera verificar el dispositivo. Compruebe que esté conectado, que se pueda escribir y que tenga suficiente espacio libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportation a échoué avant que l'appareil puisse être vérifié. Vérifiez qu'il est connecté, accessible en écriture et qu'il dispose de suffisamment d'espace libre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az exportálás sikertelen volt, mielőtt az eszközt ellenőrizni lehetett volna. Ellenőrizze, hogy csatlakoztatva van-e, írható-e, és van-e elég szabad helye."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione non è riuscita prima che il dispositivo potesse essere verificato. Verificare che sia connesso, scrivibile e disponga di spazio libero sufficiente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが検証される前にエクスポートが失敗しました。接続されていること、書き込み可能であること、および十分な空き領域があることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치를 확인하기 전에 내보내기에 실패했습니다. 연결되어 있고 쓰기 가능하며 여유 공간이 충분한지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De export mislukte voordat het apparaat kon worden geverifieerd. Controleer of het is aangesloten, beschrijfbaar is en voldoende vrije ruimte heeft."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação falhou antes que o dispositivo pudesse ser verificado. Verifique se ele está conectado, pode ser gravado e tem espaço livre suficiente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт не удалось выполнить до того, как устройство удалось проверить. Убедитесь, что он подключен, доступен для записи и имеет достаточно свободного места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporten misslyckades innan enheten kunde verifieras. Kontrollera att den är ansluten, skrivbar och har tillräckligt med ledigt utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz doğrulanamadan dışa aktarma işlemi başarısız oldu. Bağlı olduğundan, yazılabilir olduğundan ve yeterli boş alana sahip olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在验证设备之前导出失败。检查它是否已连接、可写并且有足够的可用空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在驗證設備之前匯出失敗。检查它是否已连接、可写并且有足够的可用空间。"
          }
        }
      }
    },
    "The selected USB device is no longer connected. Refresh and select it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané zařízení USB již není připojeno. Aktualizujte a vyberte jej znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
