    "Wait for the current backup to finish before changing its folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před změnou složky počkejte na dokončení aktuální zálohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent til den aktuelle sikkerhedskopiering er færdig, før du ændrer dens mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis die aktuelle Sicherung abgeschlossen ist, bevor Sie den Ordner ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιμένετε να ολοκληρωθεί το τρέχον αντίγραφο ασφαλείας πριν αλλάξετε τον φάκελό του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a que finalice la copia de seguridad actual antes de cambiar su carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin de la sauvegarde en cours avant de modifier son dossier."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várja meg, amíg az aktuális biztonsági mentés befejeződik, mielőtt megváltoztatná a mappáját."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi il completamento del backup corrente prima di modificarne la cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバックアップが完了するまで待ってから、フォルダーを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더를 변경하기 전에 현재 백업이 완료될 때까지 기다리십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot de huidige back-up is voltooid voordat u de map wijzigt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a conclusão do backup atual antes de alterar sua pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем менять папку, дождитесь завершения текущей резервной копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänta tills den aktuella säkerhetskopieringen är klar innan du byter mapp."
