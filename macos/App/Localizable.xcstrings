    "No player is master, so there is no tempo to take." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný hráč není mistr, takže není potřeba ubírat tempo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen spiller er mester, så der er ikke noget tempo at tage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Spieler ist Meister, daher gibt es kein Tempo, das man einhalten muss."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένας παίκτης δεν είναι κύριος, επομένως δεν υπάρχει ρυθμός που πρέπει να ακολουθήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún jugador es maestro, por lo que no hay ritmo que seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun joueur n’est maître, il n’y a donc aucun tempo à prendre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy játékos sem mester, így nincs tempó, amit fel kell venni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun giocatore è padrone, quindi non c'è tempo da prendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのプレイヤーもマスターではないので、テンポを取る必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 플레이어도 마스터가 아니므로 취할 템포가 없습니다."
