        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott USB-eszköz már nincs csatlakoztatva. Frissítse, és válassza ki újra."
          }
        },
        "it" : {
          "stringUnit" : {
