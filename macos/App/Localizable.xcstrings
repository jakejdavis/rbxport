    "Applies to the key menu and tracks sorted by key on connected players. Disconnect to change." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro nabídku kláves a skladby seřazené podle klávesy na připojených přehrávačích. Pro změnu odpojte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder for nøglemenuen og numre sorteret efter tast på tilsluttede afspillere. Afbryd forbindelsen for at ændre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für das Tastenmenü und nach Tasten sortierte Titel auf angeschlossenen Playern. Trennen Sie die Verbindung, um etwas zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για το βασικό μενού και τα κομμάτια ταξινομημένα κατά πλήκτρο σε συνδεδεμένες συσκευές αναπαραγωγής. Αποσύνδεση για αλλαγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica al menú de teclas y a las pistas ordenadas por tecla en los reproductores conectados. Desconectar para cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique au menu clé et aux pistes triées par clé sur les lecteurs connectés. Déconnectez-vous pour changer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csatlakoztatott lejátszók kulcsmenüjére és billentyűk szerint rendezett számokra vonatkozik. Válassza le a kapcsolatot a módosításhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica al menu chiave e ai brani ordinati per chiave sui lettori collegati. Disconnettersi per cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されているプレーヤーのキー メニューとキーで並べ替えられたトラックに適用されます。変更するには切断してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 플레이어의 키 메뉴 및 키별로 정렬된 트랙에 적용됩니다. 변경하려면 연결을 끊으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor het hoofdmenu en de nummers gesorteerd op toets op aangesloten spelers. Verbreek de verbinding om te veranderen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se ao menu principal e às faixas classificadas por tecla nos reprodutores conectados. Desconecte-se para mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется к меню клавиш и трекам, отсортированным по клавишам на подключенных проигрывателях. Отключитесь, чтобы измениться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller nyckelmenyn och spår sorterade efter tangent på anslutna spelare. Koppla från för att ändra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı oynatıcılardaki tuş menüsü ve tuşa göre sıralanan parçalar için geçerlidir. Değiştirmek için bağlantıyı kesin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于已连接播放器上按按键排序的按键菜单和曲目。断开连接进行更改。"
          }
        },
        "zh-Hant" : {
