        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele speler is meester, dus er is geen tempo dat moet worden aangehouden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum jogador é mestre, então não há ritmo a ser determinado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один игрок не является мастером, поэтому нет необходимости выбирать темп."
